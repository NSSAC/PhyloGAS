#!/bin/bash

set -euo pipefail

# Anchor to this script's own location so the submission directory does not
# matter. This script lives in src/genetic_painter/test/, so the painter is one
# level up at src/genetic_painter/genetic_painter.py.
# The `cd` is required: output_dir (below) is relative to this directory.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${script_dir}"
code="${script_dir}/../genetic_painter.py"
[[ -r "${code}" ]] || { echo "ERROR: cannot read painter: ${code}" >&2; exit 1; }

## Define output directory
output_dir="run.03.vadelta.output"

## Ensure the directory exists
mkdir -p "${output_dir}"

## Inputs for both analyses.
### Analysis type.
analysis_type="entropy_analysis"

random_number_seed=43

### Output files to be written.
threshold_file="${output_dir}/run.03.threshold.file"
# np.save() appends .npy, so this writes run.03.base.threshold.df.npy, which is
# what run.03.vadelta.b and .both read back.
base_threshold_df="${output_dir}/run.03.base.threshold.df"

# Fasta file of genomic sequences.
align_fasta="/project/bii_nssac/biocomplexity/synth_biosrv/clean_va_delta_sequences.fasta"

# Fail early and clearly rather than part way through reading the MSA.
[[ -r "${align_fasta}" ]] \
    || { echo "ERROR: cannot read required input: ${align_fasta}" >&2; exit 1; }

# NOTE: no compression/threading flags here. This step only reads the MSA and
# writes three small text/npy files; it is CPU-light (~30 s for a
# 16,525 x 29,903 alignment) and is unaffected by the painting optimisations.

# Build as an array so paths cannot be word-split; `-u` keeps progress visible
# in SLURM logs. The previous `eval "$cmd"` form would have broken on any path
# containing a space.
cmd=(
    python -u "${code}"
    --analysis_type      "${analysis_type}"
    --random_number_seed "${random_number_seed}"
    --threshold_file     "${threshold_file}"
    --align_fasta        "${align_fasta}"
    --base_threshold_df  "${base_threshold_df}"
)

printf 'Running: %s\n' "${cmd[*]}"
"${cmd[@]}"

# Confirm the artefacts the painting step depends on were actually produced.
for f in "${threshold_file}" "${base_threshold_df}.npy"; do
    [[ -s "${f}" ]] || { echo "ERROR: expected output missing or empty: ${f}" >&2; exit 1; }
done
echo "Entropy analysis complete:"
echo "  ${threshold_file}"
echo "  ${base_threshold_df}.npy"
