# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env

# OS cruft
.DS_Store

# --- Run artifacts -------------------------------------------------------
# Painter / pipeline outputs. These are regenerable and often enormous
# (a single sequences.fasta.xz can be >100 MB); they must not enter history.
results/
experiments/
**/run.03.vadelta.output/
*.sequences.fasta*
*.metadata.tsv*
*.threshold.file
*.base.threshold.df.npy
*_entropy.csv

# SLURM logs
*.out
*.err
slurm-*.out

# Snakemake
.snakemake/

# --- Large inputs --------------------------------------------------------
# Fetched from Dataverse by `phylogas fetch-data`, never committed.
data/example_data/
data/importations/sequences/
data/variant_soup*/
*.fasta.gz
*.fasta.xz
*.csv.gz
*.csv.xz
*.tsv.gz
*.fa

# Per-state data directories: downloaded by `phylogas fetch-data` or symlinked
# from a cluster. Large and/or externally owned; never committed.
data/va/
data/ca/
data/ga/
data/ma/
data/mn/
data/wa/

# Uncompressed cluster tables. These are Dataverse/UShER-derived inputs, not
# repo source. `hybrid_synthetic_clusters_delta.tsv` alone is 96 MB - larger
# than every tracked file in the repo combined. Compress and host externally
# rather than committing; git cannot ever forget a blob once added.
data/importations/*.tsv
data/*.snakemake.log

# Editor / workspace local settings
*.code-workspace

# --- One-off data-publishing operations ---------------------------------
# Scripts and scraped source material used once to mirror the synthetic
# populations from UVA Dataverse to Zenodo. Operational, not software: they
# are not imported by the package, have no tests, and are irrelevant to anyone
# installing PhyloGAS. Kept on disk and copied to the cluster where they run.
# The provenance of the generated metadata is recorded in
# docs/mirroring_populations_to_zenodo.md, which IS tracked.
scripts/zenodo/
docs/source_material/
dataverse_html.txt
zenodo_doi.txt
